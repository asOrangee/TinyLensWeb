{
  "name": "tinylens-workbench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "agent:server": "node server/agent-server.mjs",
    "test:agent": "node --test server/*.test.mjs",
    "test:position": "node --experimental-strip-types --test tests/position-likelihood.test.ts",
    "test:submission": "node --experimental-strip-types --test tests/message-intent.test.ts",
    "test:tasks": "node --experimental-strip-types --test tests/demo-tasks.test.ts",
    "test:mapping": "node --experimental-strip-types --test tests/lens-mapping.test.ts",
    "test:results": "node --experimental-strip-types --test tests/live-results.test.ts",
    "test": "pnpm test:frontend && pnpm test:agent",
    "test:frontend": "node --experimental-strip-types --test tests/*.test.ts",
    "doctor": "node scripts/doctor.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "~5.9.3",
    "vite": "^7.1.12"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
