# Copy to .env.local on the computer running the web bridge. No AI keys here.
# Configure HostName, User, Port and IdentityFile in your own ~/.ssh/config.
TINYLENS_SSH_HOST=tinylens-gpu
TINYLENS_REMOTE_WORKSPACE=/srv/TinyLensWeb/pipeline
TINYLENS_REMOTE_PYTHON=/opt/conda/envs/tinylens_gpu/bin/python
TINYLENS_REMOTE_CODEX=/usr/local/bin/codex
# Optional dedicated Codex home on the GPU server; contains YOUR config/auth.
TINYLENS_REMOTE_CODEX_HOME=
# Optional initial input directory; new tasks can specify their inputs in chat.
TINYLENS_DATASET_PATH=
# Optional authenticated, temporary CONNECT tunnel to a local HTTP proxy.
# The default uses the GPU server's own network. This tunnel allows only official
# OpenAI login/API hosts; custom providers need the server's own network/proxy.
TINYLENS_AI_NETWORK=off
TINYLENS_PROXY_PORT=7897
# 0 lets SSH allocate a free loopback port. A fixed port remains optional.
TINYLENS_REMOTE_PROXY_PORT=0
